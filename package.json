{
	"name": "native-say",
	"version": "0.0.3",
	"description": "Native text-to-speech for macOS and Windows",
	"license": "MIT",
	"repository": "github:LitoMore/native-say",
	"homepage": "https://github.com/LitoMore/native-say#readme",
	"bugs": "https://github.com/LitoMore/native-say/issues",
	"author": "LitoMore",
	"type": "module",
	"exports": {
		".": {
			"types": "./distribution/source/index.d.ts",
			"default": "./distribution/source/index.js"
		},
		"./mac": {
			"types": "./distribution/source/mac.d.ts",
			"default": "./distribution/source/mac.js"
		},
		"./windows": {
			"types": "./distribution/source/windows.d.ts",
			"default": "./distribution/source/windows.js"
		}
	},
	"sideEffects": false,
	"engines": {
		"node": ">=20.5"
	},
	"scripts": {
		"prepublishOnly": "node --run build",
		"build": "del-cli distribution && tsc",
		"dev": "del-cli distribution && tsc --watch",
		"test": "xo"
	},
	"files": [
		"distribution/source"
	],
	"keywords": [
		"say",
		"macos",
		"windows",
		"spoken-content",
		"text-to-speech",
		"speech"
	],
	"dependencies": {
		"execa": "^9.6.1",
		"fkill": "^7.2.1",
		"tasklist": "^6.0.0"
	},
	"devDependencies": {
		"@sindresorhus/tsconfig": "^8.1.0",
		"@types/node": "^25.6.0",
		"@typescript/native": "npm:typescript@^7.0.2",
		"del-cli": "^7.0.0",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"xo": "^5.0.1"
	}
}
